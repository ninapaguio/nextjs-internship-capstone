# Next.js Configuration
# Copy this file to .env.local and fill in your values
# Run: cp .env.example .env.local

# ============================================
# CLERK AUTHENTICATION
# ============================================
# Get your keys from https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk URLs (update these after deploying)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# DATABASE (Task 3.2)
# ============================================
# Neon Database
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ============================================
# PUSHER CHANNELS (REALTIME boad and notification SYNC)
# ============================================
# Create a free Channels app at https://dashboard.pusher.com
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_app_key
PUSHER_SECRET=your_app_secret
PUSHER_CLUSTER=your_app_cluster

# ============================================
# Testing (E2E) Credentials for clerk
# ============================================

E2E_CLERK_USER_EMAIL=owner+clerk_test@example.com
E2E_CLERK_USER_PASSWORD=your_test_password
